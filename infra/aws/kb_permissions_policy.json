{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeTitanEmbeddings",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": "arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-embed-text-v2:0"
    },
    {
      "Sid": "ReadSourceBucket",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::legumamies-rag-040416400623-2e32fb7c",
        "arn:aws:s3:::legumamies-rag-040416400623-2e32fb7c/*"
      ],
      "Condition": { "StringEquals": { "aws:ResourceAccount": "040416400623" } }
    },
    {
      "Sid": "S3VectorsReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3vectors:GetIndex",
        "s3vectors:PutVectors",
        "s3vectors:GetVectors",
        "s3vectors:QueryVectors",
        "s3vectors:ListVectors",
        "s3vectors:DeleteVectors"
      ],
      "Resource": "arn:aws:s3vectors:us-east-1:040416400623:bucket/legumamies-rag-vectors-040416400623/*"
    }
  ]
}
